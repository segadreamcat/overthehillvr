<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OverTheHillVR</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <AssemblySearchPaths>$(AssemblySearchPaths);..\..\MelonLoader\Il2CppAssemblies;..\..\MelonLoader\net6</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>..\..\MelonLoader\net6\MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" />
    <Reference Include="UnityEngine.PhysicsModule" />
    <Reference Include="Il2Cppmscorlib" />
    <Reference Include="UnityDirectInput.Runtime" />
    <Reference Include="Unity.InputSystem" />
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" />
    <Reference Include="UnityEngine.UIModule" />
    <Reference Include="Il2CppFusion.Runtime" />
    <Reference Include="UnityEngine.ImageConversionModule" />
    <Reference Include="UnityEngine.ScreenCaptureModule" />
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>..\..\MelonLoader\net6\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppGPUInstancerPro.Core" />
  </ItemGroup>
</Project>
